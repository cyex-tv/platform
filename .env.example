# Copy to .env for local development. Never commit .env.
# Values match dev/docker-compose.yaml.

CYEX_TV_DATABASE_URL=postgres://cyextv:cyextv-dev-only@127.0.0.1:5432/cyextv

# Optional, with their defaults
# CYEX_TV_BIND=0.0.0.0:8080            # api 8080, events 8081
# CYEX_TV_DB_MAX_CONNECTIONS=10
# CYEX_TV_DB_STATEMENT_TIMEOUT_MS=5000
# CYEX_TV_DB_ACQUIRE_TIMEOUT_MS=5000
# CYEX_TV_READ_CACHE_MS=5000          # api: how long chat-client reads are shared (0 = off)
CYEX_TV_LOG=info,cyex_tv_api=debug
CYEX_TV_LOG_FORMAT=pretty

# Sign-in (ADR 0009). Defaults are production: https://api.cyex.tv and https://cyex.tv.
# For local development, point both at localhost; the cookie then drops Domain and Secure.
# CYEX_TV_PUBLIC_URL=http://localhost:8080
# CYEX_TV_SITE_URL=http://localhost:5173
# CYEX_TV_COOKIE_DOMAIN=                 # empty: host-only cookie
# CYEX_TV_COOKIE_SECURE=false
# OAuth clients from docs/setup/owner-steps.md. Without both halves, that platform's sign-in answers 503.
# Real values go in .env only, never here.
# CYEX_TV_TWITCH_CLIENT_ID=
# CYEX_TV_TWITCH_CLIENT_SECRET=
# CYEX_TV_KICK_CLIENT_ID=
# CYEX_TV_KICK_CLIENT_SECRET=

# The owner (ADR 0010): holds every permission and can't be demoted. Comma-separated
# twitch:<user id>, kick:<user id> or cyex.tv account IDs. Set the real value in .env only.
# CYEX_TV_OWNER_IDS=twitch:<id>,kick:<id>

# Behind the Cloudflare tunnel, take the client IP for rate limits from CF-Connecting-IP.
# Only set this where every request really comes through Cloudflare.
# CYEX_TV_TRUST_CLOUDFLARE=true

# Rate limits (api). Each is <count>/<window>, the window in s, m, h or d (600/1m, 30/1h, 5/30s).
# Unset keeps the default shown; a value that doesn't read stops the api at start, naming it.
# Per IP:
# CYEX_TV_LIMIT_AUTH=30/1m               # /v1/auth/*
# CYEX_TV_LIMIT_GQL=300/1m               # POST /v1/gql
# CYEX_TV_LIMIT_UPLOAD=30/1h             # POST /v1/emotes and cosmetics images
# How many uploads the API checks (decodes) at the same time, across POST /v1/emotes and the
# cosmetic picture upload; the rest wait up to 10 s, then get 503 `busy` with Retry-After.
# Default: the number of CPUs, at least 1.
# CYEX_TV_UPLOAD_CHECKS=4
# CYEX_TV_LIMIT_READS=1200/1m            # the public REST reads
# CYEX_TV_LIMIT_SOCKET=60/1m             # opening /v1/gql/ws
# Per developer API key (ADR 0033), in place of the per-IP reads and gql limits:
# CYEX_TV_LIMIT_API_KEY=3000/1m          # public reads and GraphQL queries with a key
# CYEX_TV_LIMIT_API_KEY_ACCOUNT=3000/1m  # all of one account's keys together
# Per account (a role can raise or lower these on the Roles page; signed out: per IP where noted):
# CYEX_TV_LIMIT_GQL_ACCOUNT=600/1m       # POST /v1/gql
# CYEX_TV_LIMIT_ACCOUNT_SEARCH=60/1m     # searchAccounts (per IP signed out)
# CYEX_TV_LIMIT_QUICK_SEARCH=240/1m      # quickSearch (per IP signed out)
# CYEX_TV_LIMIT_HEAVY_READS=120/1m       # activity and set lists (per IP signed out)
# CYEX_TV_LIMIT_EDITORS=60/1h
# CYEX_TV_LIMIT_COSMETICS=300/1h
# CYEX_TV_LIMIT_SET_CLONES=30/1h
# CYEX_TV_LIMIT_PERSONAL_LISTS=120/1m    # hides and favourites
# CYEX_TV_LIMIT_EMOTE_TRANSFERS=60/1h
# CYEX_TV_LIMIT_PREFS=120/1h
# CYEX_TV_LIMIT_CHECKOUT=30/1h
# CYEX_TV_LIMIT_REDEEM=30/1h
# CYEX_TV_LIMIT_DATA_EXPORT=5/1h
# CYEX_TV_LIMIT_DELETE_ACCOUNT=3/1h      # not per role
# CYEX_TV_LIMIT_CONSOLE_TOKENS=5/1h      # console tokens minted (ADR 0028), not per role
# Whole numbers, per account, also per role:
# CYEX_TV_LIMIT_UPLOADS_PER_HOUR=20      # emotes uploaded (and received from editors) an hour
# CYEX_TV_LIMIT_PENDING_EMOTES=20        # emotes waiting for review at once
# CYEX_TV_LIMIT_SET_CAPACITY_MAX=1000    # slots an account may give one of its channel sets (staff: up to 1000000)
# A whole number, per IP, not per role:
# CYEX_TV_LIMIT_SOCKETS_PER_IP=50        # /v1/gql/ws sockets one IP may hold open at once

# Media limits, read by the api and the worker (give both the same values; either refuses to start
# on a value that doesn't read). <KIND> is DEFAULT (cosmetic pictures in general), BADGE or PAINT;
# the numbers shown are the defaults. Emotes have no variables: their upload rules are fixed in
# code and the same for everyone (1000 x 1000 px, 8 MB, 1000 frames, 50 fps, 4:1; ADR 0031).
# An old CYEX_TV_LIMIT_EMOTE_* or CYEX_TV_LIMIT_ROLE_EMOTE_* line is ignored: delete it.
# CYEX_TV_LIMIT_<KIND>_MAX_BYTES=8388608      # DEFAULT 5242880; file size in bytes
# CYEX_TV_LIMIT_<KIND>_MAX_SIDE=1000          # BADGE 2048, PAINT 4096, DEFAULT 1000 (px)
# CYEX_TV_LIMIT_<KIND>_MAX_FRAMES=1000        # BADGE and PAINT 120, DEFAULT 1000
# CYEX_TV_LIMIT_<KIND>_MAX_TOTAL_PIXELS=100000000   # width x height x frames; BADGE and PAINT 64000000
# CYEX_TV_LIMIT_<KIND>_MAX_DURATION_MS=none   # one run of an animation; BADGE and PAINT 10000, `none`: no cap
# What a role may set a kind's file limits to (`setRoleLimits`: bytes, side, frames). A role can raise
# a badge or paint above the numbers above, up to these. Emotes can't be set per role.
# They set the largest upload body and decoder buffer, so keep them to what the servers can decode.
# CYEX_TV_LIMIT_ROLE_<KIND>_MAX_BYTES=16777216   # all kinds 16 MB
# CYEX_TV_LIMIT_ROLE_<KIND>_MAX_SIDE=4096        # BADGE 4096, PAINT 6144 (px)
# CYEX_TV_LIMIT_ROLE_<KIND>_MAX_FRAMES=240       # BADGE and PAINT 240
# The badge and paint size ladder:
# CYEX_TV_LIMIT_BADGE_MASTER_PX=512           # every badge size is scaled from a master this big
# CYEX_TV_LIMIT_BADGE_ORIGINAL_PX=512         # the `original` file is fitted into this many px
# CYEX_TV_LIMIT_BADGE_CHAT_ANIMATED_BYTES=524288   # animated 18, 36 and 72 px files
# CYEX_TV_LIMIT_BADGE_128_ANIMATED_BYTES=1048576   # animated files kept at this size, up to
# CYEX_TV_LIMIT_BADGE_256_ANIMATED_BYTES=2097152
# CYEX_TV_LIMIT_BADGE_512_ANIMATED_BYTES=4194304
# CYEX_TV_LIMIT_BADGE_ORIGINAL_ANIMATED_BYTES=8388608
# CYEX_TV_LIMIT_PAINT_512_ANIMATED_BYTES=4194304

# Prometheus metrics at GET /metrics on their own listener (api, events, worker). Unset: off.
# Bind it on the private Docker network only, never behind a tunnel route.
# CYEX_TV_METRICS_BIND=0.0.0.0:9100

# Takedowns purge the CDN through Cloudflare's API (worker). Real values in .env only.
# CYEX_TV_CLOUDFLARE_ZONE_ID=
# CYEX_TV_CLOUDFLARE_PURGE_TOKEN=

# Where emote files are served (default https://cdn.cyex.tv)
# CYEX_TV_CDN_URL=http://localhost:9000/cyex-tv-cdn
# The website's CSP allows pictures from https://cdn.cyex.tv only; for another CDN, build or run
# the site with the same address in PUBLIC_CDN_URL (apps/web/svelte.config.js).
# PUBLIC_CDN_URL=http://localhost:9000/cyex-tv-cdn

# Object storage (ADR 0003): the dev S3 server (dev/docker-compose.yaml) locally, R2 in production.
# The worker needs it; without it, jobs that store files fail.
# CYEX_TV_S3_ENDPOINT=http://127.0.0.1:9000
# CYEX_TV_S3_BUCKET=cyex-tv-cdn
# CYEX_TV_S3_ACCESS_KEY_ID=cyextv
# CYEX_TV_S3_SECRET_ACCESS_KEY=cyextv-dev-only
# CYEX_TV_S3_REGION=auto
# Direct uploads of badge and paint pictures (ADR 0036): the https address browsers PUT to (it
# reaches the S3 server, see docs/setup/owner-steps.md). Unset: no direct uploads, the form is used.
# CYEX_TV_S3_UPLOAD_ENDPOINT=https://upload.cyex.tv

# Tests: the database test runs only when this is set
# CYEX_TV_TEST_DATABASE_URL=postgres://cyextv:cyextv-dev-only@127.0.0.1:5432/cyextv
# and the S3 tests when these are (against the dev S3 server)
# CYEX_TV_TEST_S3_ENDPOINT=http://127.0.0.1:9000
# CYEX_TV_TEST_S3_ACCESS_KEY_ID=cyextv
# CYEX_TV_TEST_S3_SECRET_ACCESS_KEY=cyextv-dev-only
